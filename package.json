{
  "name": "uniforge",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "npm@11.16.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:desktop": "node scripts/build-desktop.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "unit": "vitest run",
    "e2e-smoke": "playwright test",
    "check-boundaries": "node scripts/check-boundaries.mjs",
    "check-doc-links": "node scripts/check-doc-links.mjs",
    "check-baseline": "node scripts/check-baseline.mjs",
    "check:boundaries": "npm run check-boundaries",
    "check:doc-links": "npm run check-doc-links",
    "check:baseline": "npm run check-baseline",
    "test:group": "node scripts/run-test-group.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "electron": "44.2.0",
    "eslint": "10.10.0",
    "globals": "16.3.0",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
