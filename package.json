{
  "name": "uniforge",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "build:desktop": "node scripts/build-desktop.mjs",
    "package-windows": "node scripts/package-windows.mjs",
    "verify:windows-package": "node scripts/verify-windows-package.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check package.json tsconfig.base.json tsconfig.json tsconfig.tests.json .prettierrc.json .github/workflows/stage-0.yml eslint.config.mjs vitest.config.ts playwright.config.ts scripts apps/desktop packages tests docs/governance docs/decisions docs/release docs/test-evidence",
    "unit": "node scripts/run-test-group.mjs unit",
    "integration": "node scripts/run-test-group.mjs integration",
    "security": "npm audit --audit-level=high",
    "license": "node scripts/check-licenses.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "e2e-smoke": "npm run build:desktop && playwright test",
    "check-boundaries": "node scripts/check-boundaries.mjs",
    "check-doc-links": "node scripts/check-doc-links.mjs",
    "check-baseline": "node scripts/check-baseline.mjs",
    "check:boundaries": "npm run check-boundaries",
    "check:doc-links": "npm run check-doc-links",
    "check:baseline": "npm run check-baseline",
    "test:group": "node scripts/run-test-group.mjs",
    "poc:model": "node scripts/poc-model.mjs",
    "poc:knowledge": "node scripts/poc-knowledge.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "electron": "44.2.0",
    "eslint": "10.10.0",
    "globals": "16.3.0",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
